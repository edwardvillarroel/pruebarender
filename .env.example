# === Backend (app/) ===
FLASK_APP=app
FLASK_ENV=development

# Base de datos - Supabase / PostgreSQL (proyecto egcpkhmcyjxihxbdsjxf)
# Desarrollo: host directo, IPv6-only (no resuelve por IPv4).
DATABASE_URL=postgresql://postgres:<password>@db.egcpkhmcyjxihxbdsjxf.supabase.co:5432/postgres?sslmode=require
# Tests: base propia en Supabase, la suite R0 debe dejarla en 0 filas.
TEST_DATABASE_URL=postgresql://postgres:<password>@db.egcpkhmcyjxihxbdsjxf.supabase.co:5432/postgres_test?sslmode=require
# Despliegue: usar el Session Pooler (IPv4, pocas conexiones), NO el host directo.
#   postgresql://postgres.egcpkhmcyjxihxbdsjxf:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Seleccion de motor. El default SIEMPRE es postgres; Oracle solo entra con
# DB_BACKEND=oracle explicito mas las variables ORACLE_* de mas abajo. No hay
# fallback silencioso: reintroducir ORACLE_* sin DB_BACKEND no cambia la base.
DB_BACKEND=postgres
TEST_DB_BACKEND=postgres
POSTGRES_SSLMODE=require
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5

# CORS
CORS_ORIGINS=http://localhost:5173

# Frontend build (produccion)
FRONTEND_BASE_URL=/ApoloVibes3D-Frontend/

# LLM
LLM_API_KEY=
LLM_BASE_URL=

# Pasarela de pagos TUU (Pago Online de Haulmer). Cuenta/Secret de prueba por
# defecto; en producción reemplazar con credenciales reales y URLs accesibles.
TUU_ACCOUNT_ID=62224230
TUU_SECRET_KEY=yAk0dXTJLQzkeEWODsQWVpPX0bn7ND50qwoQrXgqqNiUyEpgxIPxPtoCgKeLNeh1upTw72JZx5O9x5IaAtPIGUAVcMNcsUSg3M0M8tgWdUb4F8qkS8I7rHpOUmZqzvfS
TUU_API_URL=https://frontend-api.payment.haulmer.dev/v1/payment
TUU_SHOP_NAME=ApoloVibes
TUU_URL_CALLBACK=http://localhost:3000/api/pago/callback
TUU_URL_COMPLETE=http://localhost:5173/pago/retorno
TUU_URL_CANCEL=http://localhost:5173/checkout

# Seguimiento Starken (portal developers.starken.cl). API key de la cuenta de
# la PYME; sin STARKEN_API_KEY el seguimiento queda deshabilitado (no rompe el
# flujo de pedidos, solo no muestra estado de envío).
# STARKEN_MODO_SIMULACION=1 inyecta un cliente simulado (estados deterministas
# por código) para desarrollo/demo — no requiere API key ni llamadas HTTP.
STARKEN_API_URL=https://gateway.starken.cl
STARKEN_API_KEY=
STARKEN_SEGUIMIENTO_RUTA=/orden-flete/of/
STARKEN_TIMEOUT=10
STARKEN_MODO_SIMULACION=

# === Correos del gateway (EmailJS) ===
# Envío REAL del código de verificación (registro) y recuperación de contraseña.
# Sin estas credenciales el envío queda en MODO SIMULACIÓN: el código se imprime
# en la consola del gateway (solo servidor, para desarrollo) y NUNCA se expone
# por la API ni en la interfaz.
# Para activar el envío real, en el dashboard de EmailJS (dashboard.emailjs.com):
#   - Crear una plantilla que use las variables {{to_email}} y {{codigo}}.
#   - Activar "Allow API for non-browser applications" (llamadas desde el servidor).
#   - Si está habilitado "Use Private Key", el campo `accessToken` es obligatorio.
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# === Correos del backend (EmailJS) ===
# Comprobante de pedido post-pago. Comparte cuenta con el gateway pero usa
# una PLANTILLA PROPIA: un comprobante no es un codigo de verificacion.
# Sin estas credenciales (o sin la plantilla) el comprobante se imprime en
# la consola del backend (MODO SIMULACION) y el pago NO se rompe.
# Ver app/infrastructure/correo/emailjs.py.
# La plantilla debe usar {{to_email}}, {{pedido_id}}, {{estado}}, {{total}},
# {{entrega}}, {{items}} y {{fecha}}.
EMAILJS_TEMPLATE_COMPROBANTE=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Gateway (gateway/) ===
GATEWAY_SECRET_KEY=change-me
GATEWAY_JWT_SECRET=change-me
BACKEND_INTERNAL_URL=http://localhost:8000
# En dev (http) poner 0; en prod (https) poner 1
GATEWAY_COOKIE_SECURE=0

# --- Rollback a Oracle (inactivo, solo si hay que volver atras) ---
# La migracion esta CERRADA: la base activa es Supabase y el .env real no tiene
# ninguna de estas variables. Para re-activar Oracle hacen falta las cinco MAS
# DB_BACKEND=oracle. Ver docs/RUNBOOK-MIGRACION-SUPABASE.md seccion 5.
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_DSN=apolodev_high
ORACLE_WALLET_DIR=C:/ruta/a/Wallet_APOLODEV
ORACLE_WALLET_PASSWORD=
