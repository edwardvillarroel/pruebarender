# Aplicación
FLASK_APP=app
FLASK_ENV=development
PORT=4000

# Base de datos
DATABASE_URL=postgresql://app:app@localhost:5432/print3d_dev
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/print3d_test

# Seguridad
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# CORS (dev: "*" permite todo). Para producción, lista de orígenes separados por coma.
CORS_ORIGINS=*

# Serve del frontend construido por Flask (producción).
# Por defecto busca en roots/ApoloVibes-frontend/dist; solo definir si el build vive en otra ruta.
# FRONTEND_DIST=/ruta/absoluta/Al/build
FRONTEND_BASE_URL=/ApoloVibes3D-Frontend/

# LLM
LLM_API_KEY=
LLM_BASE_URL=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Oracle Autonomous - modo CON wallet mTLS (usado si ORACLE_DSN y ORACLE_PASSWORD existen)
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_DSN=apolodev_high
ORACLE_WALLET_DIR=C:/ruta/a/Wallet_APOLODEV
ORACLE_WALLET_PASSWORD=