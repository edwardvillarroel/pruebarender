# === Backend (app/) ===
FLASK_APP=app
FLASK_ENV=development

# Base de datos (PostgreSQL - tests)
DATABASE_URL=postgresql://app:app@localhost:5432/print3d_dev
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/print3d_test

# CORS
CORS_ORIGINS=http://localhost:5173

# Frontend build (produccion)
FRONTEND_BASE_URL=/ApoloVibes3D-Frontend/

# LLM
LLM_API_KEY=
LLM_BASE_URL=

# Pasarela de pagos TUU (Pago Online de Haulmer). Cuenta/Secret de prueba por
# defecto; en producción reemplazar con credenciales reales y URLs accesibles.
TUU_ACCOUNT_ID=62224230
TUU_SECRET_KEY=yAk0dXTJLQzkeEWODsQWVpPX0bn7ND50qwoQrXgqqNiUyEpgxIPxPtoCgKeLNeh1upTw72JZx5O9x5IaAtPIGUAVcMNcsUSg3M0M8tgWdUb4F8qkS8I7rHpOUmZqzvfS
TUU_API_URL=https://frontend-api.payment.haulmer.dev/v1/payment
TUU_SHOP_NAME=ApoloVibes
TUU_URL_CALLBACK=http://localhost:3000/api/pago/callback
TUU_URL_COMPLETE=http://localhost:5173/pago/retorno
TUU_URL_CANCEL=http://localhost:5173/checkout

# Seguimiento Starken (portal developers.starken.cl). API key de la cuenta de
# la PYME; sin STARKEN_API_KEY el seguimiento queda deshabilitado (no rompe el
# flujo de pedidos, solo no muestra estado de envío).
# STARKEN_MODO_SIMULACION=1 inyecta un cliente simulado (estados deterministas
# por código) para desarrollo/demo — no requiere API key ni llamadas HTTP.
STARKEN_API_URL=https://gateway.starken.cl
STARKEN_API_KEY=
STARKEN_SEGUIMIENTO_RUTA=/orden-flete/of/
STARKEN_TIMEOUT=10
STARKEN_MODO_SIMULACION=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Gateway (gateway/) ===
GATEWAY_SECRET_KEY=change-me
GATEWAY_JWT_SECRET=change-me
BACKEND_INTERNAL_URL=http://localhost:8000
# En dev (http) poner 0; en prod (https) poner 1
GATEWAY_COOKIE_SECURE=0

# Oracle Autonomous
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_DSN=apolodev_high
ORACLE_WALLET_DIR=C:/ruta/a/Wallet_APOLODEV
ORACLE_WALLET_PASSWORD=
